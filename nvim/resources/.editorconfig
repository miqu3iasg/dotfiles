# EditorConfig: https://editorconfig.org
# Copy to the project root. Editors and many tools read it natively, so it is
# the broadest contract in the stack; the dedicated configs in this folder stay
# authoritative for their own tools.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
max_line_length = 120

# Web files follow the 2-space convention their tooling assumes by default.
[*.{js,jsx,ts,tsx,mjs,cjs,html,css,scss,json,yaml,yml}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
