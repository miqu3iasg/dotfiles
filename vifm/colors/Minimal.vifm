" You can edit this file by hand.
" The " character at the beginning of a line comments out the line.
" Blank lines are ignored.

" The Default color scheme is used for any directory that does not have
" a specified scheme and for parts of user interface like menus. A
" color scheme set for a base directory will also
" be used for the sub directories.

" The standard ncurses colors are:
" Default = -1 = None, can be used for transparency or default color
" Black = 0
" Red = 1
" Green = 2
" Yellow = 3
" Blue = 4
" Magenta = 5
" Cyan = 6
" White = 7

" Light versions of colors are also available (they set bold
" attribute in terminals with less than 16 colors):
" LightBlack
" LightRed
" LightGreen
" LightYellow
" LightBlue
" LightMagenta
" LightCyan
" LightWhite

" Available attributes (some of them can be combined):
" bold
" underline
" reverse or inverse
" standout
" italic (on unsupported systems becomes reverse)
" combine
" none

" Vifm supports 256 colors you can use color numbers 0-255
" (requires properly set up terminal: set your TERM environment variable
" (directly or using resources) to some color terminal name (e.g.
" xterm-256color) from /usr/lib/terminfo/; you can check current number
" of colors in your terminal with tput colors command)

" highlight group cterm=attrs ctermfg=foreground_color ctermbg=background_color

highlight clear

highlight Win        cterm=none ctermfg=default ctermbg=default
highlight OtherWin   cterm=none ctermfg=default ctermbg=default
highlight AuxWin     cterm=none ctermfg=default ctermbg=default
highlight OddLine    cterm=none ctermfg=default ctermbg=default
highlight LineNr     cterm=none ctermfg=8       ctermbg=default

highlight CurrLine   cterm=none ctermfg=15      ctermbg=235
highlight OtherLine  cterm=none ctermfg=default ctermbg=0
highlight Selected   cterm=bold ctermfg=11      ctermbg=default

highlight Directory  cterm=bold ctermfg=4       ctermbg=default
highlight Executable cterm=bold ctermfg=2       ctermbg=default
highlight StatusLine cterm=none ctermfg=246     ctermbg=default
highlight Link       cterm=none ctermfg=6       ctermbg=default
highlight HardLink   cterm=none ctermfg=6       ctermbg=default
highlight BrokenLink cterm=none ctermfg=1       ctermbg=default
highlight Socket     cterm=none ctermfg=8       ctermbg=default
highlight Device     cterm=none ctermfg=8       ctermbg=default
highlight Fifo       cterm=none ctermfg=8       ctermbg=default

highlight TopLine    cterm=none ctermfg=8       ctermbg=default
highlight TopLineSel cterm=bold ctermfg=4       ctermbg=default
highlight StatusLine cterm=none ctermfg=8       ctermbg=default
highlight JobLine    cterm=none ctermfg=8       ctermbg=default
highlight Border     cterm=none ctermfg=238     ctermbg=default
highlight TabLine    cterm=none ctermfg=8       ctermbg=default
highlight TabLineSel cterm=bold ctermfg=4       ctermbg=default

highlight CmdLine    cterm=none ctermfg=default ctermbg=default
highlight ErrorMsg   cterm=bold ctermfg=1       ctermbg=default
highlight WildMenu   cterm=none ctermfg=15      ctermbg=235
highlight SuggestBox cterm=none ctermfg=default ctermbg=default

highlight CmpMismatch  cterm=none ctermfg=1       ctermbg=default
highlight CmpUnmatched cterm=none ctermfg=8       ctermbg=default
highlight CmpBlank     cterm=none ctermfg=default ctermbg=default
