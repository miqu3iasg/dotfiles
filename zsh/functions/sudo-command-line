# zsh/functions/sudo-command-line
#
# Prepend or remove "sudo " from the command line.
#
# See: conf.d/widgets.zsh

[[ -z $BUFFER ]] && zle up-history

if [[ $BUFFER == sudo\ * ]]; then
    BUFFER="${BUFFER#sudo }"
    (( CURSOR = CURSOR > 5 ? CURSOR - 5 : 0 ))
else
    BUFFER="sudo $BUFFER"
    (( CURSOR += 5 ))
fi
