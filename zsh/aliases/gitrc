# Worktree
# See: https://stackoverflow.com/a/47698869 (using awk in shell alias)
alias \
  gwl='git worktree list' \
  gwr='git worktree list | awk "NR>1 {print \$1}" | fzf --exit-0 | xargs -r git worktree remove'

gwa() {
  local inside_worktree
  inside_worktree=$(git rev-parse --is-inside-work-tree) || return "$?"
  [ "$inside_worktree" = false ] && echo 'Not inside git worktree' && return 1

  local git_root git_branch worktree_dir
  git_root=$(git rev-parse --show-toplevel) || return "$?"
  git_branch=$(git branch -a | awk '/^[^*+]/ {print $1}' | fzf --exit-0) || return "$?"
  worktree_dir=$(printf '%s\n' $git_branch | sed 's/\//-/g') || return "$?"
  if [ -n "$git_branch" ]; then
    git worktree add \
      "${XDG_STATE_HOME:-$HOME/.local/state}/git-worktrees/${git_root##*/}/$worktree_dir" "$git_branch" || return "$?"
  fi
}

gwc() {
  local inside_worktree selected workdir

  inside_worktree=$(git rev-parse --is-inside-work-tree) || return "$?"
  [ "$inside_worktree" = false ] && echo 'Not inside git worktree' && return 1

  workdir="$PWD"

  # See: https://stackoverflow.com/a/7584479
  selected="$(git worktree list |
    awk -v "pwd=$workdir" '$1 != pwd {print $1}' |
    fzf --exit-0)" ||
    return "$?"

  cd "$selected"
}

