[global]
    monitor = 0
    follow = mouse
    width = (300, 360)
    height = (0, 220)
    origin = top-right
    offset = (16, 16)
    gap_size = 8
    notification_limit = 5

    font = Inter 10
    markup = full
    format = "<b>%s</b>\n<span alpha='60%%'>%b</span>"
    alignment = left
    vertical_alignment = center
    line_height = 2
    ellipsize = end
    word_wrap = yes

    frame_width = 1
    corner_radius = 3
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    transparency = 0
    separator_height = 0
    progress_bar = true
    progress_bar_height = 6
    progress_bar_corner_radius = 1
    progress_bar_frame_width = 0

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 2
    enable_recursive_icon_lookup = true

    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#000000"
    foreground = "#6e6e6e"
    frame_color = "#141414"
    highlight = "#3a3a3a"
    timeout = 3

[urgency_normal]
    background = "#000000"
    foreground = "#cfcfcf"
    frame_color = "#1f1f1f"
    highlight = "#8a8a8a"
    timeout = 5

[urgency_critical]
    background = "#1a0c0c"
    foreground = "#e3d3d3"
    frame_color = "#4a2323"
    highlight = "#a85a5a"
    timeout = 0
