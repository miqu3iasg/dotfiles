[user]
	name = miqu3iasg
	email = 147787560+miqu3iasg@users.noreply.github.com

[init]
	defaultBranch = main

[core]
	pager = delta
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore_global

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	side-by-side = false
	line-numbers = true
	syntax-theme = none
	minus-style = "red"
	plus-style = "green"
	minus-emph-style = "reverse red"
	plus-emph-style = "reverse green"

[merge]
	conflictstyle = diff3
	tool = nvimdiff

[mergetool "nvimdiff"]
	cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[diff]
	colorMoved = default
	algorithm = histogram

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[fetch]
	prune = true
	pruneTags = true

[rerere]
	enabled = true

[help]
	autocorrect = 10

[commit]
	verbose = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[status]
	submoduleSummary = true

[credential]
	helper = cache --timeout=3600

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	lg = log --oneline --graph --decorate --all
	unstage = restore --staged
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	aliases = config --get-regexp ^alias\\.
