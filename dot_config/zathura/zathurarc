# General
set guioptions ""
set font "JetBrains Mono 10"

# Save reading position, zoom and marks per file
set database "sqlite"

# Always open fit-to-width
set adjust-open "width"

# Window title shows filename only, not full path
set window-title-basename true

# Pre-render offscreen pages for smoother scrolling
set render-loading true

# Navigation and scroll

set scroll-step 60
set scroll-hstep 60
set scroll-full-overlap 0.01

set zoom-min 10
set zoom-max 1000

# Send selection to system clipboard, not just primary selection
set selection-clipboard clipboard

# Dark mode (page recoloring)
set recolor true
set recolor-lightcolor "#000000"
set recolor-darkcolor "#dcdcdc"

# Keep original hues on graphics/diagrams instead of full grayscale
set recolor-keephue true

# Interface theme 

# Statusbar
set statusbar-fg "#cccccc"
set statusbar-bg "#0a0a0a"

# Inputbar (command/search line)
set inputbar-bg "#0a0a0a"
set inputbar-fg "#ffffff"

# Notifications (grayscale only, no color coding)
set notification-error-bg "#1a1a1a"
set notification-error-fg "#ffffff"
set notification-warning-bg "#141414"
set notification-warning-fg "#cccccc"

# Search/selection highlight (alpha channel controls transparency directly)
set highlight-color "rgba(120,120,120,0.35)"
set highlight-active-color "rgba(180,180,180,0.45)"
set highlight-fg "rgba(255,255,255,0.9)"

# Command completion menu
set completion-bg "#0a0a0a"
set completion-fg "#aaaaaa"
set completion-highlight-bg "#333333"
set completion-highlight-fg "#ffffff"

# Main window background (visible in gaps/margins)
set default-bg "#000000"
set default-fg "#dcdcdc"

# SyncTeX (LaTeX editor <-> PDF sync)
set synctex true
set synctex-editor-command "code --goto %{input}:%{line}"

# Keybinds

# Utils
map K zoom in
map J zoom out
map p print

# Toggle dark mode
map <C-r> recolor

# Rotate page
map r rotate

# Jump to first/last page
map gg goto top
map G goto bottom

# Search
map / search
map n search forward
map N search backward

# Presentation / fullscreen mode
map <F5> toggle_fullscreen

# Reload document
map R reload

# Copy current file path to clipboard
map <C-c> feedkeys ":exec echo -n '%{filepath}' | xclip -selection clipboard<Return>"
map y feedkeys ":exec echo -n '%{filepath}' | xclip -selection clipboard<Return>"
