# /home/miqu3iasg/.config/zsh/aliasrc

# General replacements
alias cat='bat'                     # cat with syntax highlighting
alias g='git'
alias ls='eza'
alias ll='eza -lah'                 # long listing, all files, human-readable sizes
alias la='eza -A'                   # all files, short format
alias lt='eza --tree --level=2'     # tree view, 2 levels deep
alias lta='eza --tree --level=2 -a' # tree view, 2 levels deep, all files

# Shell shortcuts
alias c='clear'
alias q='exit'

# Colorized output
alias grep='grep --color=auto'
alias diff='diff --color=auto'

# Confirm before overwriting or bulk-deleting
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -I'

# Neovim
alias vim='nvim'
alias vi='nvim'
alias im='nvim'

# Open the Neovim config directory in Neovim
alias nvcfg='cd ~/.config/nvim && nvim .'

# Neovim profiles
#
# NVIM_APPNAME gives each profile its own config, plugins, state,
# and cache directories under ~/.config/<appname>.
# Useful for testing configurations without touching the main setup.
alias nvs='NVIM_APPNAME=nvim-scratch nvim' # scratch profile
alias nvn='NVIM_APPNAME=nvim-min nvim'     # minimal profile

# Pick from Neovim's recently opened files (via oldfiles) and open
# the selection. Also cds into the directory of the first file picked.
nvr() {
    local oldfiles=(
        "${(@f)$(nvim -u NONE --headless \
            +'lua io.write(table.concat(vim.v.oldfiles, "\n") .. "\n")' \
            +qa 2>/dev/null)}"
    )

    local valid_files=()

    for file in "${oldfiles[@]}"; do
        [[ -f "$file" ]] && valid_files+=("$file")
    done

    local files=(
        "${(@f)$(printf '%s\n' "${valid_files[@]}" |
            fzf --multi \
                --preview 'bat -n --color=always --line-range=:500 {} 2>/dev/null || echo "Error previewing file"' \
                --height=70% \
                --layout=reverse)}"
    )

    if [[ ${#files[@]} -gt 0 ]]; then
        local first_dir=$(dirname "${files[1]}")

        cd -- "$first_dir" || {
            echo "Failed to cd to $first_dir"
            return 1
        }

        nvim "${files[@]}"
    fi
}

# File search

# Find files recursively, including hidden files, excluding .git
alias ff='fd --type f --hidden --exclude .git'

# List files tracked by ripgrep's file search, excluding .git
alias rgf='rg --files --hidden --glob "!.git"'

# Navigation

# cd to the root of the current Git repository
groot() {
    cd "$(git rev-parse --show-toplevel)"
}

# cd to the root of the current Git repository and open it in Neovim
croot() {
    cd "$(git rev-parse --show-toplevel)" &&
        nvim .
}

# Create a directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Show the directory stack (recently visited directories)
d() {
    dirs -v | head
}

# Fuzzy-find a directory under $HOME (up to 2 levels deep) and cd into it.
# Limited to 2 levels to avoid searching the entire home directory.
#
# See: https://www.linuxquestions.org/questions/linux-newbie-8/xargs-cd-is-not-working-796219/#post3906430 (why cd does not work with xargs)
# See: https://www.linuxquestions.org/questions/linux-newbie-8/xargs-cd-is-not-working-796219/#post3907371 (about pipeline)
alias sd='cd "$(find ~ -mindepth 1 -maxdepth 2 -name .eclipse -prune -o -type d | fzf --height 20% --bind change:first)"'

# Search and open files

# Search file contents with ripgrep, preview matches with bat,
# and open the selected match in Neovim at the matched line
sf() {
    local result

    result=$(
        rg --line-number --no-heading --hidden --glob '!.git' "$*" |
            fzf --delimiter : \
                --preview 'bat --color=always --highlight-line {2} {1}' \
                --preview-window 'right,60%,border-left' \
                --bind 'enter:become(nvim {1} +{2})'
    )

    [[ -n "$result" ]] && nvim "${result%%:*}" "+${result#*:}"
}

# List files in the current directory (excluding .git) with fzf,
# allowing multi-select to open in Neovim, or Ctrl+/ to preview with less.
# Refuses to run from $HOME to avoid listing the entire home directory.
alias sc='[ "$PWD" != "$HOME" ] &&
    rg --hidden --files --glob "!.git" |
    fzf --multi \
        --height 20% \
        --bind "enter:become(nvim {+})" \
        --bind "ctrl-/:execute(less -c -i --incsearch --search-options=W -g {})"'

# Archive extraction

# Extract common archive formats based on file extension
extract() {
    if [[ -z "$1" || ! -f "$1" ]]; then
        echo "Usage: extract <file>"
        return 1
    fi

    case "$1" in
        *.tar.bz2)  tar xjf "$1" ;;
        *.tar.gz)   tar xzf "$1" ;;
        *.tar.xz)   tar xJf "$1" ;;
        *.tar)      tar xf "$1" ;;
        *.tbz2)     tar xjf "$1" ;;
        *.tgz)      tar xzf "$1" ;;
        *.bz2)      bunzip2 "$1" ;;
        *.gz)       gunzip "$1" ;;
        *.zip)      unzip "$1" ;;
        *.rar)      unrar x "$1" ;;
        *.7z)       7z x "$1" ;;
        *.Z)        uncompress "$1" ;;
        *)          echo "extract: unsupported format '$1'" ;;
    esac
}

# Obsidian

# Open the Obsidian vault (path from $OBSIDIAN_VAULT_PATH) in Neovim
oo() {
    if [[ ! -d "$OBSIDIAN_VAULT_PATH" ]]; then
        echo "Obsidian vault not found:"
        echo "$OBSIDIAN_VAULT_PATH"
        return 1
    fi

    nvim "$OBSIDIAN_VAULT_PATH"
}

# Starship theme switcher

# Switch the active Starship theme globally and persistently.
#
# Starship reads ~/.config/starship.toml by default, so this function
# keeps that path as a symlink to the chosen theme, stored next to it as
# starship.<name>.toml. Because the link lives on disk, the choice
# survives new shells and reboots, and every open terminal picks it up
# on its next prompt, since Starship re-reads its config on each run.
#
# This only works while STARSHIP_CONFIG is unset: when set, Starship
# uses that file and ignores the symlink. To make it work, remove any
# export of STARSHIP_CONFIG from ~/.zshrc, and in terminals that are
# already open, run:
#
#   $ unset STARSHIP_CONFIG
#
# Usage:
#   sp <name>   switch to starship.<name>.toml
#   sp          show the current theme and list the available ones
#
# If starship.toml exists as a regular file, it is moved to
# starship.toml.bak before the link is created, so nothing is lost.
#
# See: https://starship.rs/config/ (config location and STARSHIP_CONFIG)
# See: https://specifications.freedesktop.org/basedir-spec/latest/ (XDG_CONFIG_HOME)
# See: https://man7.org/linux/man-pages/man1/ln.1.html (symbolic links)
sp() {
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}"
    local link="$dir/starship.toml"
    local name="$1"
    local f

    # With no argument, report the current theme and list the others.
    # The current theme is the target of the symlink, with the
    # "starship." prefix and ".toml" suffix removed.
    if [[ -z "$name" ]]; then
        local current="${$(readlink -f "$link" 2>/dev/null):t:r}"
        echo "current: ${current#starship.}"
        echo "available:"

        # (N) avoids an error when nothing matches; :t keeps the file
        # name and :r drops the extension.
        # The pattern requires a name between the dots, so the link
        # itself (starship.toml) is never listed.
        # See: https://zsh.sourceforge.io/Doc/Release/Expansion.html (glob qualifiers and modifiers)
        for f in "$dir"/starship.*.toml(N:t:r); do
            echo "  ${f#starship.}"
        done
        return
    fi

    local target="$dir/starship.$name.toml"

    if [[ ! -f "$target" ]]; then
        echo "sp: theme '$name' not found ($target)"
        return 1
    fi

    # Back up a regular file before replacing it. Existing symlinks are
    # skipped, since ln -sf below overwrites them safely.
    [[ -e "$link" && ! -L "$link" ]] && mv "$link" "$link.bak"

    ln -sf "$target" "$link"
}

# Tab completion for theme names, built from the same file pattern that
# sp uses, so new themes are completed as soon as the file exists.
# See: https://zsh.sourceforge.io/Doc/Release/Completion-System.html (compdef and compadd)
_sp() {
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}"
    local -a themes=("$dir"/starship.*.toml(N:t:r))

    # Strip the "starship." prefix from every entry.
    themes=("${themes[@]#starship.}")

    compadd -a themes
}
compdef _sp sp

# Yazi

# Open Yazi and cd the shell into whatever directory it exits into
y() {
    local tmp cwd

    tmp="$(mktemp)"

    yazi "$@" --cwd-file="$tmp"

    if [[ -r "$tmp" ]]; then
        cwd="$(cat -- "$tmp")"

        if [[ -n "$cwd" && "$cwd" != "$PWD" && -d "$cwd" ]]; then
            cd -- "$cwd"
        fi
    fi

    rm -f -- "$tmp"
}
