# ~/.config/zsh/aliasrc

# General replacements
alias cat='bat'                     # cat with syntax highlighting

# Functions instead of aliases so extra arguments can be passed and combined with the flags of each variant.
_eza() {
    eza --group-directories-first --time-style=long-iso "$@"
}
l()   { _eza -ahl "$@"; }
ls()  { _eza "$@"; }
la()  { _eza -A "$@"; }                   # all files, short format
ll()  { _eza -lah --git "$@"; }           # long listing, header, git status

# Sorting (the most relevant entry ends up last, next to the prompt)
lm()  { _eza -lah --git --sort=modified "$@"; }   # newest last
lS()  { _eza -lah --git --sort=size "$@"; }       # largest last
lsd() { _eza -lah --only-dirs "$@"; }             # directories only
lsf() { _eza -lah --only-files "$@"; }            # files only

# inode, octal permissions, link count, allocated blocks, owner/group and exact size in bytes.
lx()  {
    _eza -la --inode --octal-permissions --links --blocksize --group \
         --bytes --git "$@"
}

# Same as lx, but with numeric UID/GID and extended attributes (xattrs).
# Useful for debugging permissions in containers, mounts, NFS, SELinux, etc.
lxx() {
    _eza -la --inode --octal-permissions --links --blocksize --group \
         --numeric --extended --bytes "$@"
}

# Total size of each directory, recursively (slow on large trees)
lz()  { _eza -lah --total-size --sort=size "$@"; }

# Git status per repository (useful for a projects directory)
lgr() { _eza -lah --git --git-repos "$@"; }

# Trees (accept -L N to change the depth)
lt()  { _eza --tree --level=2 --git-ignore "$@"; }                # respects .gitignore
lta() { _eza --tree --level=2 -a --ignore-glob='.git' "$@"; }     # all files, except .git
ltl() { _eza --tree --level=2 -l --git --git-ignore "$@"; }       # tree with details

