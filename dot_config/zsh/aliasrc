# Aliases

alias cat='bat'
alias g='git'
alias vim='nvim'
alias ls='eza'
alias ll='eza -lah'
alias la='eza -A'
alias lt='eza --tree --level=2'
alias lta='eza --tree --level=2 -a'

alias c='clear'
alias q='exit'

alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -I'

# Open the Neovim configuration
alias nvc='cd ~/.config/nvim && nvim .'


# Neovim profiles

# NVIM_APPNAME gives each profile its own config, plugins,
# state, and cache directories under ~/.config/<appname>.
#
# Useful for testing configurations without touching the main setup.
alias nvim-scratch='NVIM_APPNAME=nvim-scratch nvim'
alias nvim-min='NVIM_APPNAME=nvim-min nvim'

# File search

# Find files recursively, including hidden files but excluding .git
alias ff='fd --type f --hidden --exclude .git'

# List files tracked by ripgrep's file search
alias rgf='rg --files --hidden --glob "!.git"'


# Navigation

# Jump to the root directory of the current Git repository
groot() {
    cd "$(git rev-parse --show-toplevel)"
}

# Jump to the Git repository root and open it in Neovim
croot() {
    cd "$(git rev-parse --show-toplevel)" &&
        nvim .
}

# Create a directory and enter it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Show the directory stack
d() {
    dirs -v | head
}


# Search and open files

# Search file contents and open the selected match in Neovim
sf() {
    local result

    result=$(
        rg --line-number --no-heading --hidden --glob '!.git' "$*" |
            fzf --delimiter : \
                --preview 'bat --color=always --highlight-line {2} {1}' \
                --preview-window 'right,60%,border-left' \
                --bind 'enter:become(nvim {1} +{2})'
    )

    [[ -n "$result" ]] && nvim "${result%%:*}" "+${result#*:}"
}

# Search and open files from the current directory
alias sc='[ "$PWD" != "$HOME" ] &&
    rg --hidden --files --glob "!.git" |
    fzf --multi \
        --height 20% \
        --bind "enter:become(nvim {+})" \
        --bind "ctrl-/:execute(less -c -i --incsearch --search-options=W -g {})"'


# Neovim recent files

# List Neovim's recently opened files and open the selection with nvim
nlof() {
    local oldfiles=(
        "${(@f)$(nvim -u NONE --headless \
            +'lua io.write(table.concat(vim.v.oldfiles, "\n") .. "\n")' \
            +qa 2>/dev/null)}"
    )

    local valid_files=()

    for file in "${oldfiles[@]}"; do
        [[ -f "$file" ]] && valid_files+=("$file")
    done

    local files=(
        "${(@f)$(printf '%s\n' "${valid_files[@]}" |
            fzf --multi \
                --preview 'bat -n --color=always --line-range=:500 {} 2>/dev/null || echo "Error previewing file"' \
                --height=70% \
                --layout=reverse)}"
    )

    if [[ ${#files[@]} -gt 0 ]]; then
        local first_dir=$(dirname "${files[1]}")

        cd -- "$first_dir" || {
            echo "Failed to cd to $first_dir"
            return 1
        }

        nvim "${files[@]}"
    fi
}


# Archive extraction

# Extract common archive formats with one command
extract() {
    if [[ -z "$1" || ! -f "$1" ]]; then
        echo "Usage: extract <file>"
        return 1
    fi

    case "$1" in
        *.tar.bz2)  tar xjf "$1" ;;
        *.tar.gz)   tar xzf "$1" ;;
        *.tar.xz)   tar xJf "$1" ;;
        *.tar)      tar xf "$1" ;;
        *.tbz2)     tar xjf "$1" ;;
        *.tgz)      tar xzf "$1" ;;
        *.bz2)      bunzip2 "$1" ;;
        *.gz)       gunzip "$1" ;;
        *.zip)      unzip "$1" ;;
        *.rar)      unrar x "$1" ;;
        *.7z)       7z x "$1" ;;
        *.Z)        uncompress "$1" ;;
        *)          echo "extract: unsupported format '$1'" ;;
    esac
}


# Obsidian

# Open the Obsidian vault in Neovim
oo() {
    if [[ ! -d "$OBSIDIAN_VAULT_PATH" ]]; then
        echo "Obsidian vault not found:"
        echo "$OBSIDIAN_VAULT_PATH"
        return 1
    fi

    nvim "$OBSIDIAN_VAULT_PATH"
}


# Yazi

# Open Yazi and change the shell directory to the selected location
y() {
    local tmp cwd

    tmp="$(mktemp)"

    yazi "$@" --cwd-file="$tmp"

    if [[ -r "$tmp" ]]; then
        cwd="$(cat -- "$tmp")"

        if [[ -n "$cwd" && "$cwd" != "$PWD" && -d "$cwd" ]]; then
            cd -- "$cwd"
        fi
    fi

    rm -f -- "$tmp"
}
