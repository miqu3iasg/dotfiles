# File search

# Find files recursively, including hidden files, excluding .git
alias ff='fd --type f --hidden --exclude .git'

# List files tracked by ripgrep's file search, excluding .git
alias rgf='rg --files --hidden --glob "!.git"'

# Navigation

# cd to the root of the current Git repository
groot() {
    cd "$(git rev-parse --show-toplevel)"
}

# cd to the root of the current Git repository and open it in Neovim
croot() {
    cd "$(git rev-parse --show-toplevel)" &&
        nvim .
}

# Create a directory and cd into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Show the directory stack (recently visited directories)
d() {
    dirs -v | head
}

# Fuzzy-find a directory under $HOME (up to 2 levels deep) and cd into it.
# Limited to 2 levels to avoid searching the entire home directory.
#
# See: https://www.linuxquestions.org/questions/linux-newbie-8/xargs-cd-is-not-working-796219/#post3906430 (why cd does not work with xargs)
# See: https://www.linuxquestions.org/questions/linux-newbie-8/xargs-cd-is-not-working-796219/#post3907371 (about pipeline)
alias sd='cd "$(find ~ -mindepth 1 -maxdepth 3 -name .eclipse -prune -o -type d | fzf --height 20% --bind change:first)"'

# Search and open files

# Search file contents with ripgrep, preview matches with bat,
# and open the selected match in Neovim at the matched line
sf() {
    local result

    result=$(
        rg --line-number --no-heading --hidden --glob '!.git' "$*" |
            fzf --delimiter : \
                --preview 'bat --color=always --highlight-line {2} {1}' \
                --preview-window 'right,60%,border-left' \
                --bind 'enter:become(nvim {1} +{2})'
    )

    [[ -n "$result" ]] && nvim "${result%%:*}" "+${result#*:}"
}

# Run a GUI program detached from the shell, silencing its output.
_detach() { "$@" &>/dev/null &! }

# List files with fd and pick with fzf (multi-select).
# Usage: _pick <preview-cmd> [fd args...]
# Preview starts hidden; toggle with Ctrl+Space.
_pick() {
    local preview="$1"
    shift

    fd --type f --hidden --exclude .git --strip-cwd-prefix "$@" |
        fzf --multi \
            --preview "$preview" \
            --bind 'ctrl-space:toggle-preview' \
            --preview-window 'right,50%,hidden'
}

# Pick files and open all selections in one viewer instance.
# Usage: _pick_open <viewer> <preview-cmd> [fd args...]
_pick_open() {
    local viewer="$1" preview="$2"
    shift 2

    local -a files=("${(@f)$(_pick "$preview" "$@")}")

    [[ -n ${files[1]} ]] && _detach "$viewer" "${files[@]}"
}

_pdf_preview='pdfinfo {} 2>/dev/null || echo "no preview"'
_img_preview='file -b {}'
_img_ext=(-e jpg -e jpeg -e png -e gif -e webp -e bmp -e svg)

sfp() { _pick_open zathura "$_pdf_preview" -e pdf; }             # PDFs -> zathura (light)
sfpo() { _pick_open okular  "$_pdf_preview" -e pdf; }            # PDFs -> okular (annotations)
sfi() { _pick_open imv     "$_img_preview" "${_img_ext[@]}"; }   # images -> imv

# List files in the current directory (excluding .git) with fzf and open
# the selection with the right tool, grouped by type so that several
# selections open in a single window: PDFs -> zathura, images -> imv,
# text -> nvim, anything else -> xdg-open. Ctrl+/ previews with less.
# Refuses to run from $HOME to avoid listing the entire home directory.
sc() {
    if [[ "$PWD" == "$HOME" ]]; then
        echo "sc: refusing to run from \$HOME"
        return 1
    fi

    local -a files=("${(@f)$(
        rg --hidden --files --glob '!.git' |
            fzf --multi \
                --height 20% \
                --bind 'ctrl-/:execute(less -c -i --incsearch --search-options=W -g {})'
    )}")
    local -a pdfs imgs texts others
    local f

    [[ -n ${files[1]} ]] || return

    for f in "${files[@]}"; do
        case "${f:l}" in
            *.pdf)
                pdfs+=("$f") ;;
            *.png|*.jpg|*.jpeg|*.gif|*.webp|*.bmp|*.svg)
                imgs+=("$f") ;;
            *)
                if [[ "$(file -b --mime-type -- "$f")" == (text/*|application/json|inode/x-empty) ]]; then
                    texts+=("$f")
                else
                    others+=("$f")
                fi ;;
        esac
    done

    (( $#pdfs ))  && _detach zathura "${pdfs[@]}"
    (( $#imgs ))  && _detach imv "${imgs[@]}"
    for f in "${others[@]}"; do _detach xdg-open "$f"; done
    (( $#texts )) && nvim -- "${texts[@]}"
}

# Archive extraction

# Extract common archive formats based on file extension
extract() {
    if [[ -z "$1" || ! -f "$1" ]]; then
        echo "Usage: extract <file>"
        return 1
    fi

    case "$1" in
        *.tar.bz2)  tar xjf "$1" ;;
        *.tar.gz)   tar xzf "$1" ;;
        *.tar.xz)   tar xJf "$1" ;;
        *.tar)      tar xf "$1" ;;
        *.tbz2)     tar xjf "$1" ;;
        *.tgz)      tar xzf "$1" ;;
        *.bz2)      bunzip2 "$1" ;;
        *.gz)       gunzip "$1" ;;
        *.zip)      unzip "$1" ;;
        *.rar)      unrar x "$1" ;;
        *.7z)       7z x "$1" ;;
        *.Z)        uncompress "$1" ;;
        *)          echo "extract: unsupported format '$1'" ;;
    esac
}

