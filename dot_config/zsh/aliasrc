# Standard library source

# Directory where cloned/extracted sources are kept
_src_root="${XDG_DATA_HOME:-$HOME/.local/share}/stdsrc"

# Open a directory in Neovim, failing with a clear message if it doesn't exist
_open_src() {
    local dir="$1"

    if [[ -z "$dir" || ! -d "$dir" ]]; then
        echo "source directory not found: ${dir:-<empty>}"
        return 1
    fi

    nvim -- "$dir"
}

# Shallow-clone a repo once (name, url optional tag/branch) and open it.
# Later calls reuse the existing clone.
_git_src() {
    local name="$1" url="$2" ref="$3"
    local dest="$_src_root/$name"
    local -a args=(--depth 1)

    [[ -n "$ref" ]] && args+=(--branch "$ref")

    if [[ ! -d "$dest" ]]; then
        echo "cloning $name${ref:+ ($ref)}..."
        git clone "${args[@]}" "$url" "$dest" || {
            rm -rf "$dest"
            return 1
        }
    fi

    _open_src "$dest"
}

# Rust
# Requires: sudo pacman -S rust-src
stdrs() { _open_src "$(rustc --print sysroot)/lib/rustlib/src/rust/library"; }

# Go
stdgo() { _open_src "$(go env GOROOT)/src"; }

# Python
stdpy() { _open_src "$(python3 -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')"; }

# C
# glibc, following the release branch matching the installed version.
# Arch builds glibc from the release/X.Y/master branch (a few commits
# past the tag), so the branch is closer than the tag.
# Requires: sudo pacman -S man-pages
stdc() {
    local ver
    ver="$(ldd --version | head -1 | grep -oE '[0-9]+\.[0-9]+$')"

    _git_src glibc "https://sourceware.org/git/glibc.git" "${ver:+release/$ver/master}"
}

# Lua
# The stdlib is written in C, so this opens the interpreter source
stdlua() {
    local ver
    ver="$(lua -v 2>/dev/null | awk '{print $2}')"

    _git_src lua "https://github.com/lua/lua.git" "${ver:+v$ver}"
}

stdch() { _open_src /usr/include; }   # headers only, instant

# Java
# Extracts the JDK's src.zip once into the cache
# Requires sudo pacman -S openjdk-src (matching your installed JDK version)
stdjava() {
    local home zip dest

    home="$(dirname "$(dirname "$(readlink -f "$(command -v javac)")")")"
    zip="$home/lib/src.zip"

    if [[ ! -f "$zip" ]]; then
        echo "src.zip not found: $zip"
        return 1
    fi

    dest="${XDG_CACHE_HOME:-$HOME/.cache}/jdk-src/${home:t}"

    if [[ ! -d "$dest" ]]; then
        mkdir -p "$dest" && unzip -q "$zip" -d "$dest" || {
            rm -rf "$dest"
            return 1
        }
    fi

    _open_src "$dest"
}
