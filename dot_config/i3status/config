# i3status configuration file.
# see "man i3status" for documentation.
general {
  output_format = none
  interval = 1
  separator = "   |   "
  colors = false
  color_good = "#5faf5f"
  color_degraded = "#ffd751"
  color_bad = "#ff5f5f"
}
order += "disk /"
order += "memory"
order += "cpu_usage"
order += "cpu_temperature 0"
order += "battery all"
order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "tztime local"

wireless _first_ {
  format_up = "net %quality %frequency"
  format_down = "net down"
}

ethernet _first_ {
  format_up = "net %ip [%speed]"
  format_down = "net down"
}

battery all {
  format = "bat %percentage %remaining %consumption"
  last_full_capacity = true
  low_threshold = 35
  threshold_type = "percentage"
}

cpu_usage {
  format = "cpu %usage"
}

cpu_temperature 0 {
  format = "temp %degrees°C"
  path = "/sys/class/thermal/thermal_zone0/temp"
}

memory {
  memory_used_method = "memavailable"
  format = "mem %used"
  threshold_degraded = "1.5G"
  format_degraded = "mem LOW: %used"
}

disk "/" {
  format = "disk %used/%total"
}

tztime local {
  format = "%a %d %b  %H:%M   "
}

volume master {
  format = "vol %volume"
  format_muted = "vol mute"
  device = "default"
  mixer = "Master"
}
