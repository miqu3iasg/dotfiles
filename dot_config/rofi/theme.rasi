* {
    bg:       #000000;
    fg:       #cccccc;
    bg-alt:   #1a1a1a;
    fg-alt:   #888888;
    accent:   #111111;
    accent-fg: #f0f0f0;
    border:   #333333;

    background-color: @bg;
    text-color: @fg;
    font: "JetBrains Mono 11";
}

window {
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 0px;
    width: 800px;
}

mainbox {
    background-color: @bg;
    border: 0px;
    padding: 0px;
}

inputbar {
    background-color: @bg;
    text-color: @fg;
    border: 0px 0px 1px 0px;
    border-color: @border;
    padding: 8px;
    children: [ prompt, entry ];
}

prompt {
    background-color: @bg;
    text-color: @fg-alt;
    padding: 0px 6px 0px 0px;
}

entry {
    background-color: @bg;
    text-color: @fg;
    placeholder: "";
    blink: false;
}

listview {
    background-color: @bg;
    border: 0px;
    padding: 0px;
    lines: 10;
    spacing: 0px;
    scrollbar: false;
}

element {
    background-color: @bg;
    text-color: @fg;
    padding: 6px 8px;
    border-radius: 0px;
}

element selected {
    background-color: @accent;
    text-color: @accent-fg;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

element-icon {
    size: 0px;
}
